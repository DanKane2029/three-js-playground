{
	"name": "three-js-playground",
	"version": "2.0.0",
	"description": "A Three.js playground of small graphics apps: shaders, fractals, terrain, particles, and post-processing.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"src/**/*.{ts,scss,html}\" \"*.{ts,mjs,json,md}\"",
		"generate-code": "plop --plopfile ./code-generators/plopfile.mjs"
	},
	"author": "Dan Kane",
	"license": "ISC",
	"dependencies": {
		"three": "^0.185.1",
		"tweakpane": "^4.0.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tweakpane/core": "^2.0.5",
		"@types/three": "^0.185.1",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.7.0",
		"plop": "^4.0.5",
		"prettier": "^3.9.6",
		"sass": "^1.101.7",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5"
	}
}
